                                                    <TextBox x:Name="TxtVoiceMacroSteps" Width="220" Padding="5,3" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Margin="0,0,6,4" ToolTip="Acciones separadas por coma (ej: LandingGearToggle, DELAY:150, ShipSpotLightToggle)" />
                                                    <TextBox x:Name="TxtVoiceMacroConfirm" Width="170" Padding="5,3" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Margin="0,0,6,4" ToolTip="Confirmación de voz opcional" />
                                                    <Button x:Name="BtnAddVoiceMacro" Content="➕ Añadir" local:UiText.Key="aiVoiceMacroAdd" Style="{StaticResource HudButtonStyle}" Padding="7,3" Margin="0,0,6,4" Click="BtnAddVoiceMacro_Click" />
                                                    <Button x:Name="BtnRemoveVoiceMacro" Content="🗑 Quitar" local:UiText.Key="aiVoiceMacroRemove" Style="{StaticResource HudButtonStyle}" Padding="7,3" Margin="0,0,6,4" Click="BtnRemoveVoiceMacro_Click" />
                                                    <Button x:Name="BtnResetVoiceMacros" Content="↺ Presets" local:UiText.Key="aiVoiceMacroReset" Style="{StaticResource HudButtonStyle}" Padding="7,3" Margin="0,0,0,4" Click="BtnResetVoiceMacros_Click" />

<Window x:Class="HUDnopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HUDnopy"
        xmlns:controls="clr-namespace:HUDnopy.UI.Controls"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="HUDnopy // SHIP CONTROL SYSTEM"
        Icon="pack://application:,,,/HUDnopy;component/HUDnopy.ico"
        Height="820" Width="1340"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource HudBgBrush}"
        Foreground="{StaticResource HudTextBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CABECERA DE TELEMETRÍA GLOBAL -->
        <Border Grid.Row="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudAccentBrush}" BorderThickness="0,0,0,2" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identidad de la Aplicación y Nave -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource HudAccentBrush}" Padding="10,5" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtModeBadge" Text="INACTIVO" Foreground="#000000" FontWeight="Black" FontSize="11" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtShipTitle" Text="SIN SEÑAL" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Black" FontSize="16" />
                        <TextBlock x:Name="TxtShipSubHeader" Text="---" Foreground="{StaticResource HudMutedBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Píldoras de estado rápido -->
                <ItemsControl x:Name="HeaderModules" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{StaticResource HudPanelAltBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="2,0,0,0" Padding="12,5" Margin="6,2" MaxWidth="240">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource HudMutedBrush}" FontSize="10" TextWrapping="Wrap" Loaded="ScaledTemplateText_Loaded" />
                                <TextBlock Text="{Binding Value}" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Loaded="ScaledTemplateText_Loaded" />
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Accesos rápidos y controles de ventana -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenWebHeader" Content="🌐" ToolTip="Abrir Web" AutomationProperties.Name="Abrir Web" Style="{StaticResource HudButtonStyle}" MinWidth="42" MinHeight="38" Padding="0" Click="BtnOpenWeb_Click" />
                    <Button x:Name="BtnToggleMiniHud" Content="📌" ToolTip="Modo Mini-HUD siempre encima" AutomationProperties.Name="Mini-HUD" Style="{StaticResource HudButtonStyle}" MinWidth="42" MinHeight="38" Padding="0" Margin="8,0,0,0" Click="BtnToggleMiniHud_Click" />
                    <Button x:Name="BtnToggleOverlay" Content="🪟" ToolTip="Overlay Click-Through sobre el juego (Ctrl+Alt+O bloquear/mover)" AutomationProperties.Name="Overlay Click-Through" Style="{StaticResource HudButtonStyle}" MinWidth="42" MinHeight="38" Padding="0" Margin="8,0,0,0" Click="BtnToggleOverlay_Click" />
                    <Button x:Name="BtnToggleFullscreen" Content="⛶" ToolTip="Activar pantalla completa [F11]" AutomationProperties.Name="Pantalla completa" Style="{StaticResource HudButtonStyle}" MinWidth="42" MinHeight="38" Padding="0" Margin="8,0,0,0" Click="BtnToggleFullscreen_Click" />
                    <Button x:Name="BtnExitHeader" Content="⏻" ToolTip="Salir de la aplicación" AutomationProperties.Name="Salir" Style="{StaticResource HudButtonStyle}" MinWidth="42" MinHeight="38" Padding="0" Margin="8,0,0,0" BorderBrush="{StaticResource HudDangerBrush}" Foreground="{StaticResource HudDangerBrush}" Click="BtnExitApp_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="AlertStatusBanner" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource HudDangerBrush}" Padding="18,12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.7" BlurRadius="18" ShadowDepth="5" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TxtAlertStatusBannerTitle" Foreground="#080A0E" FontWeight="Black"
                           FontSize="16" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtAlertStatusBannerMessage" Foreground="#080A0E" FontWeight="Bold"
                           FontSize="14" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- CUERPO PRINCIPAL: BARRA LATERAL + ÁREA DE PANELES -->
        <Grid x:Name="MainLayoutGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- NAVEGACIÓN CONFIGURABLE -->
            <Border x:Name="NavigationMenu" Grid.Column="0" Background="#0A0D12" BorderBrush="#1FFFFFFF" BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="NavigationScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="NavigationItems">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource HudNavButtonStyle}" IsChecked="True" Checked="NavRadio_Checked" Tag="0" ToolTip="Resumen general">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontFamily="Segoe UI Symbol" Margin="0,0,10,0" />
                            <TextBlock Text="PANEL" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCockpit" Style="{StaticResource HudNavButtonStyle}" Checked="NavRadio_Checked" Tag="1" ToolTip="Estado y controles de vuelo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉" FontFamily="Segoe UI Symbol" Margin="0,0,10,0" />
                            <TextBlock Text="VUELO" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavNavigation" Style="{StaticResource HudNavButtonStyle}" Checked="NavRadio_Checked" Tag="2" ToolTip="Sistema actual y ruta">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌖" FontFamily="Segoe UI Symbol" Margin="0,0,10,0" />
                            <TextBlock Text="NAVEGACIÓN" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavOperations" Style="{StaticResource HudNavButtonStyle}" Checked="NavRadio_Checked" Tag="3" ToolTip="Misiones, minería y colonización">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontFamily="Segoe UI Symbol" Margin="0,0,10,0" />
                            <TextBlock Text="OPERACIONES" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavInventory" Style="{StaticResource HudNavButtonStyle}" Checked="NavRadio_Checked" Tag="4" ToolTip="Carga, materiales, ingenieros y estación">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◫" FontFamily="Segoe UI Symbol" Margin="0,0,10,0" />
                            <TextBlock Text="INVENTARIO" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavActivity" Style="{StaticResource HudNavButtonStyle}" Checked="NavRadio_Checked" Tag="5" ToolTip="Actividad reciente del diario">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="≡" FontFamily="Segoe UI Symbol" Margin="0,0,10,0" />
                            <TextBlock Text="ACTIVIDAD" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavControls" Style="{StaticResource HudNavButtonStyle}" Checked="NavRadio_Checked" Tag="6" ToolTip="Botonera y asignaciones .binds">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨︎" FontFamily="Segoe UI Symbol" Margin="0,0,10,0" />
                            <TextBlock Text="BOTONERA" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavConfig" Style="{StaticResource HudNavButtonStyle}" Checked="NavRadio_Checked" Tag="7" ToolTip="Preferencias de la aplicación">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙︎" FontFamily="Segoe UI Symbol" Margin="0,0,10,0" />
                            <TextBlock Text="AJUSTES" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CONTENEDOR DE VISTAS -->
            <Grid x:Name="MainContentGrid" Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="SectionNavigationPanel" Grid.Row="0" Visibility="Collapsed"
                        Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}"
                        BorderThickness="1" Padding="6,4" Margin="0,0,0,10">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="TxtActiveSectionTitle" DockPanel.Dock="Right"
                                   Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,6,0" />
                        <WrapPanel x:Name="SectionNavigationItems" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="ViewDashboard" Grid.Row="1" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="MiniHudContextBanner" Visibility="Collapsed" Background="{StaticResource HudPanelAltBrush}" BorderBrush="{DynamicResource HudSecondaryBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtMiniHudContext" Foreground="{DynamicResource HudSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                        <Border x:Name="LandingPadCard" Visibility="Collapsed" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudAccentBrush}" BorderThickness="2" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtLandingPadStation" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtLandingPadGuidance" Foreground="{StaticResource HudTextBrush}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtLandingPadDiagram" Foreground="{DynamicResource HudSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <UniformGrid x:Name="DashboardSummarySection" Columns="3" Tag="260" SizeChanged="ResponsiveGrid_SizeChanged" Margin="0,0,0,10">
                            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock x:Name="LblDashboardCommander" Text="COMANDANTE Y NAVE" Foreground="{StaticResource HudMutedBrush}" FontSize="10" />
                                    <TextBlock x:Name="TxtDashboardCommander" Text="CMDR DESCONOCIDO" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="16" Margin="0,5,0,2" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtDashboardShip" Text="---" Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="16" Margin="4,0">
                                <StackPanel>
                                    <TextBlock x:Name="LblDashboardLocation" Text="UBICACIÓN ACTUAL" Foreground="{StaticResource HudMutedBrush}" FontSize="10" />
                                    <TextBlock x:Name="TxtDashboardSystem" Text="---" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="16" Margin="0,5,0,2" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtDashboardLocation" Text="---" Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="LblDashboardResources" Text="RECURSOS DE VUELO" Foreground="{StaticResource HudMutedBrush}" FontSize="10" />
                                    <TextBlock x:Name="TxtDashboardResources" Text="Casco --- · Combustible ---" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="14" Margin="0,5,0,2" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtDashboardCargo" Text="Bodega ---" Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <StackPanel x:Name="DashboardOverviewSection">
                        <Border x:Name="SessionStatsCard" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="BtnResetSessionStats" DockPanel.Dock="Right" Content="🔄" ToolTip="Reiniciar sesión" Style="{StaticResource HudButtonStyle}" MinWidth="34" Padding="8,4" Margin="8,0,0,0" Click="BtnResetSessionStats_Click" />
                                    <TextBlock x:Name="LblSessionStatsTitle" Text="RESUMEN FINANCIERO Y ESTADÍSTICO DE LA SESIÓN" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="TxtSessionStatsSummary" Text="Esperando actividad de la sesión actual..." Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" />
                                <DockPanel Margin="0,6,0,0">
                                    <Button x:Name="BtnRefreshGalaxyStatus" DockPanel.Dock="Right" Content="🔄" Style="{StaticResource HudButtonStyle}" MinWidth="32" Padding="5,2" Click="BtnRefreshGalaxyStatus_Click" />
                                    <TextBlock x:Name="TxtGalaxyStatusSummary" Foreground="{StaticResource HudMutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Grid Tag="420" SizeChanged="ResponsiveSplit_SizeChanged" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="LblDashboardAlerts" Text="CENTRO DE ALERTAS VISUALES" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" />
                                    <TextBlock x:Name="TxtDashboardAlerts" Text="Sin alertas visuales." Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="LblDashboardRoute" Text="SIGUIENTE ETAPA DE RUTA" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" />
                                    <TextBlock x:Name="TxtDashboardRoute" Text="No hay ruta activa" Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="LblDashboardActivity" Text="ACTIVIDAD RECIENTE" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" />
                                <TextBlock x:Name="TxtDashboardActivity" Text="Esperando eventos del diario." Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        </StackPanel>
                </ScrollViewer>

                <!-- ESTADO Y CONTROLES DE VUELO -->
                <ScrollViewer x:Name="ViewCockpit" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel>
                            <!-- Integridad, Combustible, Bodega (izq) y Pips + Copiloto Táctico (der) -->
                            <Grid x:Name="CockpitResourcesSection" Tag="460" SizeChanged="ResponsiveSplit_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="INTEGRIDAD Y RECURSOS DE NAVE" local:UiText.Key="resources" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,12" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="INTEGRIDAD DEL CASCO (HULL)" local:UiText.Key="hull" Foreground="{StaticResource HudMutedBrush}" FontSize="11" />
                                            <TextBlock x:Name="TxtHullPercent" Text="---" HorizontalAlignment="Right" FontWeight="Bold" />
                                        </DockPanel>
                                        <ProgressBar x:Name="BarHull" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource HudAccentBrush}" Background="#05070A" BorderBrush="#33FFFFFF" Margin="0,0,0,10" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="ESTADO DEL ESCUDO" local:UiText.Key="shield" Foreground="{StaticResource HudMutedBrush}" FontSize="11" />
                                            <TextBlock x:Name="TxtShieldStatus" Text="---" HorizontalAlignment="Right" FontWeight="Bold" />
                                        </DockPanel>
                                        <ProgressBar x:Name="BarShield" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource HudSecondaryBrush}" Background="#05070A" BorderBrush="#33FFFFFF" Margin="0,0,0,12" Visibility="Collapsed" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="COMBUSTIBLE PRINCIPAL" local:UiText.Key="fuel" Foreground="{StaticResource HudMutedBrush}" FontSize="11" />
                                            <TextBlock x:Name="TxtFuelValue" Text="---" HorizontalAlignment="Right" FontWeight="Bold" />
                                        </DockPanel>
                                        <ProgressBar x:Name="BarFuel" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource HudSecondaryBrush}" Background="#05070A" BorderBrush="#33FFFFFF" Margin="0,0,0,12" />

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="CAPACIDAD DE BODEGA" local:UiText.Key="cargo" Foreground="{StaticResource HudMutedBrush}" FontSize="11" />
                                            <TextBlock x:Name="TxtCargoValue" Text="---" HorizontalAlignment="Right" FontWeight="Bold" />
                                        </DockPanel>
                                        <ProgressBar x:Name="BarCargo" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource HudAccentBrush}" Background="#05070A" BorderBrush="#33FFFFFF" Margin="0,0,0,4" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <!-- Distribución de Energía (Pips) -->
                                    <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="DISTRIBUIDOR DE ENERGÍA (PULSAR PARA AJUSTAR)" local:UiText.Key="power" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />
                                            <UniformGrid Columns="4">
                                                <Button Style="{StaticResource HudButtonStyle}" Margin="3" Click="BtnAction_Click" Tag="IncreaseSystemsPower">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="SIS" local:UiText.Key="pipSystems" Foreground="{StaticResource HudMutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="TxtPipSys" Text="---" Foreground="{DynamicResource HudAccentBrush}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource HudButtonStyle}" Margin="3" Click="BtnAction_Click" Tag="IncreaseEnginesPower">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="MOT" local:UiText.Key="pipEngines" Foreground="{StaticResource HudMutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="TxtPipEng" Text="---" Foreground="{DynamicResource HudAccentBrush}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource HudButtonStyle}" Margin="3" Click="BtnAction_Click" Tag="IncreaseWeaponsPower">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="ARM" local:UiText.Key="pipWeapons" Foreground="{StaticResource HudMutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="TxtPipWep" Text="---" Foreground="{DynamicResource HudAccentBrush}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource HudButtonStyle}" Margin="3" Click="BtnAction_Click" Tag="ResetPowerDistribution">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="RST" Foreground="{StaticResource HudMutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                                                        <TextBlock Text="⚖" Foreground="{DynamicResource HudSecondaryBrush}" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4" />
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Copiloto Táctico de Vuelo y Seguridad -->
                                    <Border x:Name="CopilotTacticalCard" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="COPILOTO TÁCTICO Y SEGURIDAD" local:UiText.Key="copilotTacticalTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                            <TextBlock x:Name="TxtCopilotTacticalStatus" Text="Sin avisos tácticos activos." Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="TargetShipCard" Visibility="Collapsed" Background="{StaticResource HudPanelAltBrush}" BorderBrush="{DynamicResource HudDangerBrush}" BorderThickness="1,2,1,1" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="OBJETIVO FIJADO" local:UiText.Key="targetTitle" Foreground="{DynamicResource HudDangerBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                            <TextBlock x:Name="TxtTargetHeader" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock x:Name="TxtTargetStatus" Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock x:Name="TxtTargetVitals" Foreground="{DynamicResource HudSecondaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Columna Derecha: Matriz Interactiva de Sistemas de la Nave -->
                            <Border x:Name="CockpitSystemsSection" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="16">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,12">

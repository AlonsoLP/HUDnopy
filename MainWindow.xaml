                                                <CheckBox x:Name="ChkAiTacticalMiningProspector" Foreground="{StaticResource HudTextBrush}" Margin="0,0,0,4" Click="ChkAiTacticalOption_Click">
                                                    <TextBlock Text="Prospección minera inteligente (núcleos profundos y minerales objetivo)" local:UiText.Key="aiTacticalMiningProspector" TextWrapping="Wrap" />
                                                </CheckBox>
                                                <CheckBox x:Name="ChkAiTacticalRadioChatter" Foreground="{StaticResource HudTextBrush}" Margin="0,0,0,0" Click="ChkAiTacticalOption_Click">

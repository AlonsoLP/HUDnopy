                                            <TextBox x:Name="TxtConfigPort" Width="90" AutomationProperties.LabeledBy="{Binding ElementName=LblConfigPort}" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="8,5" />

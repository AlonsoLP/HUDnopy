                                        <Button x:Name="BtnBrowseBindsProfile" Grid.Column="2" Content="📄" Style="{StaticResource HudButtonStyle}" MinWidth="40" Padding="4" Margin="6,0,0,0" Click="BtnBrowseBindsProfile_Click" />

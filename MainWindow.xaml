                                        <TextBlock x:Name="LblJournalPath" Text="Journal:" local:UiText.Key="journalShort" local:UiText.TooltipKey="journalPath" Foreground="{StaticResource HudMutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                        <TextBox x:Name="TxtConfigJournalPath" Grid.Column="1" AutomationProperties.LabeledBy="{Binding ElementName=LblJournalPath}" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="8,6" />
                                        <Button x:Name="BtnBrowseJournalFolder" Grid.Column="2" Content="📁" Style="{StaticResource HudButtonStyle}" MinWidth="40" Padding="4" Margin="6,0,0,0" Click="BtnBrowseJournalFolder_Click" />
                                    </Grid>
                                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" MaxWidth="480" HorizontalAlignment="Left" Margin="0,0,0,8">

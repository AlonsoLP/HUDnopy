                                            <WrapPanel>
                                                <ComboBox x:Name="CmbWebVpnInterface" AutomationProperties.LabeledBy="{Binding ElementName=LblVpnInterface}" SelectedValuePath="Id" MaxWidth="440" SelectionChanged="CmbWebVpnInterface_SelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>

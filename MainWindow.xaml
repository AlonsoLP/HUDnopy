                                    </DockPanel>
                                    <TextBlock Text="También puedes aumentar o reducir el texto con Ctrl + rueda del ratón." local:UiText.Key="fontHelp"
                                               Foreground="{StaticResource HudMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock x:Name="LblHeaderModules" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" Margin="0,12,0,6" />
                                    <WrapPanel x:Name="HeaderModuleOptions" SizeChanged="HeaderModuleOptions_SizeChanged" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <Border x:Name="ConfigThemeSection" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="PERSONALIZACIÓN DEL TEMA HUD (ESCRITORIO Y WEB)" local:UiText.Key="themeTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="LblThemeProfile" Text="Perfil:" local:UiText.Key="themeProfile" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="CmbThemePresets" AutomationProperties.LabeledBy="{Binding ElementName=LblThemeProfile}" SelectionChanged="CmbThemePresets_SelectionChanged" Padding="8,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock x:Name="LblPrimaryColor" Text="Color Primario HEX:" local:UiText.Key="primaryColor" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="TxtCustomAccentHex" AutomationProperties.LabeledBy="{Binding ElementName=LblPrimaryColor}" Width="105" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VerticalContentAlignment="Center" Padding="8,5" />
                                            <Button x:Name="BtnPickCustomColor" Content="🎨" local:UiText.TooltipKey="pickColor" Style="{StaticResource HudButtonStyle}" MinWidth="40" Padding="5,5" Margin="6,0,0,0" Click="BtnPickCustomColor_Click" />
                                            <Button x:Name="BtnApplyCustomColor" Content="Aplicar" local:UiText.Key="applyColor" Style="{StaticResource HudButtonStyle}" HorizontalAlignment="Left" Margin="6,0,0,0" Click="BtnApplyCustomColor_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ConfigTraySection" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="COMPORTAMIENTO EN SEGUNDO PLANO (BANDEJA)" local:UiText.Key="trayTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                        <CheckBox x:Name="ChkStartMinimizedToTray" Content="Iniciar directamente minimizada en la bandeja del sistema" local:UiText.Key="startMinimized" Foreground="{StaticResource HudTextBrush}" Margin="0,0,0,8" Click="ChkStartMinimizedToTray_Click" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource HudMutedBrush}" FontSize="11" LineHeight="16" local:UiText.Key="trayHelp">
                                            • Al pulsar cerrar [X], la aplicación se minimiza en la bandeja y mantiene activo el servidor web y la lectura de telemetría.
                                            &#x0a;• Para salir, haz clic derecho en el icono de la bandeja y elige «Salir».
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ConfigPathsSection" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="TxtConfigPathsTitle" Text="JUEGO Y ARCHIVOS" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />
                                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" MaxWidth="480" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>

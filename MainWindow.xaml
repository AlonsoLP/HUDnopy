                                                        <Button Content="+" Tag="TxtHullCriticalThreshold|5|1|99" Style="{StaticResource HudTouchStepButtonStyle}" MinWidth="32" MinHeight="38" Margin="2,0,0,0" Click="BtnStepNumberBox_Click" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0B0F15" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="Misiones:" local:UiText.Key="missionThreshold" Foreground="{DynamicResource HudSecondaryBrush}" FontWeight="Bold" FontSize="10" Margin="0,0,0,4" />
                                                    <WrapPanel>
                                                        <TextBlock Text="Aviso h" local:UiText.Key="thresholdWarnHrs" Foreground="{StaticResource HudMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <Button Content="−" Tag="TxtMissionExpiryWarningHours|-1|2|720" Style="{StaticResource HudTouchStepButtonStyle}" MinWidth="32" MinHeight="38" Margin="0,0,2,0" Click="BtnStepNumberBox_Click" />
                                                        <TextBox x:Name="TxtMissionExpiryWarningHours" Width="42" MinHeight="38" MaxLength="3" local:InputConstraint.Mode="Int" local:InputConstraint.Min="2" local:InputConstraint.Max="720" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="24" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="2" TextChanged="AlertThreshold_TextChanged" />
                                                        <Button Content="+" Tag="TxtMissionExpiryWarningHours|1|2|720" Style="{StaticResource HudTouchStepButtonStyle}" MinWidth="32" MinHeight="38" Margin="2,0,10,0" Click="BtnStepNumberBox_Click" />
                                                        <TextBlock Text="Crítico h" local:UiText.Key="thresholdCritHrs" Foreground="{StaticResource HudMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <Button Content="−" Tag="TxtMissionExpiryCriticalHours|-1|1|719" Style="{StaticResource HudTouchStepButtonStyle}" MinWidth="32" MinHeight="38" Margin="0,0,2,0" Click="BtnStepNumberBox_Click" />
                                                        <TextBox x:Name="TxtMissionExpiryCriticalHours" Width="42" MinHeight="38" MaxLength="3" local:InputConstraint.Mode="Int" local:InputConstraint.Min="1" local:InputConstraint.Max="719" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="1" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="2" TextChanged="AlertThreshold_TextChanged" />
                                                        <Button Content="+" Tag="TxtMissionExpiryCriticalHours|1|1|719" Style="{StaticResource HudTouchStepButtonStyle}" MinWidth="32" MinHeight="38" Margin="2,0,0,0" Click="BtnStepNumberBox_Click" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="10">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="AlertSettings_PreviewMouseWheel">
                                        <Grid x:Name="AlertSettingsGrid" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid x:Name="ConfigDeckEditorSection" Visibility="Collapsed" Tag="480" SizeChanged="ResponsiveSplit_SizeChanged" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Left Column: Deck Tabs Management (Touch-Optimized) -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="🎛 PESTAÑAS DE BOTONERA (DESKTOP + WEB)" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                    <TextBlock Text="Toca una pestaña para editarla. ★ FAVORITOS aparece automáticamente al inicio cuando marques botones con ★." Foreground="{StaticResource HudMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <ListBox x:Name="LstDeckEditorTabs" MinHeight="220" MaxHeight="320" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Margin="0,0,0,10" SelectionChanged="LstDeckEditorTabs_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="MinHeight" Value="44" />
                                                <Setter Property="Padding" Value="10,8" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button x:Name="BtnDeckTabAdd" Content="+ Nueva" Style="{StaticResource HudButtonStyle}" MinHeight="42" Padding="14,6" Margin="0,0,8,8" Click="BtnDeckTabAdd_Click" />
                                        <Button x:Name="BtnDeckTabUp" Content="▲" Style="{StaticResource HudButtonStyle}" MinWidth="44" MinHeight="42" Padding="8,6" Margin="0,0,8,8" Click="BtnDeckTabUp_Click" />
                                        <Button x:Name="BtnDeckTabDown" Content="▼" Style="{StaticResource HudButtonStyle}" MinWidth="44" MinHeight="42" Padding="8,6" Margin="0,0,8,8" Click="BtnDeckTabDown_Click" />
                                        <Button x:Name="BtnDeckTabToggleVis" Content="👁" ToolTip="Mostrar / ocultar pestaña" Style="{StaticResource HudButtonStyle}" MinWidth="44" MinHeight="42" Padding="8,6" Margin="0,0,8,8" Click="BtnDeckTabToggleVis_Click" />
                                        <Button x:Name="BtnDeckTabDelete" Content="🗑" ToolTip="Eliminar pestaña" Style="{StaticResource HudButtonStyle}" MinWidth="44" MinHeight="42" Padding="8,6" Margin="0,0,0,8" Click="BtnDeckTabDelete_Click" />
                                    </WrapPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="TxtDeckTabIcon" Grid.Row="0" Grid.Column="0" MinHeight="42" Margin="0,0,8,8" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="16" Padding="6,4" ToolTip="Icono de pestaña" />
                                        <TextBox x:Name="TxtDeckTabName" Grid.Row="0" Grid.Column="1" MinHeight="42" Margin="0,0,0,8" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VerticalContentAlignment="Center" Padding="10,6" ToolTip="Nombre de pestaña" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Contexto:" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" FontSize="11.5" />
                                        <ComboBox x:Name="CmbDeckTabAutoContext" Grid.Row="1" Grid.Column="1" MinHeight="42" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Ninguno (Manual)" Tag="" />
                                            <ComboBoxItem Content="⚔ Combate" Tag="combat" />
                                            <ComboBoxItem Content="🚙 SRV" Tag="srv" />
                                            <ComboBoxItem Content="🥾 A pie (Odyssey)" Tag="onfoot" />
                                            <ComboBoxItem Content="🛬 Aterrizaje / Atracado" Tag="landing" />
                                        </ComboBox>
                                    </Grid>
                                    <Button x:Name="BtnDeckTabSave" Content="💾 Guardar cambios de pestaña" Style="{StaticResource HudButtonStyle}" MinHeight="42" HorizontalAlignment="Left" Padding="14,6" Margin="0,0,0,12" Click="BtnDeckTabSave_Click" />
                                    <WrapPanel>
                                        <Button x:Name="BtnDeckExportJson" Content="📤 Exportar JSON" Style="{StaticResource HudButtonStyle}" MinHeight="42" Padding="12,6" Margin="0,0,8,8" Click="BtnDeckExportJson_Click" />
                                        <Button x:Name="BtnDeckImportJson" Content="📥 Importar JSON" Style="{StaticResource HudButtonStyle}" MinHeight="42" Padding="12,6" Margin="0,0,8,8" Click="BtnDeckImportJson_Click" />
                                        <Button x:Name="BtnDeckResetDefaults" Content="↺ Restaurar por defecto" Style="{StaticResource HudButtonStyle}" MinHeight="42" Padding="12,6" Margin="0,0,0,8" Click="BtnDeckResetDefaults_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right Column: Buttons inside selected tab (Touch-Optimized) -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="⚡ BOTONES DE LA PESTAÑA SELECCIONADA" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                    <ListBox x:Name="LstDeckEditorButtons" MinHeight="190" MaxHeight="270" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Margin="0,0,0,10" SelectionChanged="LstDeckEditorButtons_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="MinHeight" Value="44" />
                                                <Setter Property="Padding" Value="10,8" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button x:Name="BtnDeckBtnUp" Content="▲" Style="{StaticResource HudButtonStyle}" MinWidth="44" MinHeight="42" Padding="8,6" Margin="0,0,8,8" Click="BtnDeckBtnUp_Click" />
                                        <Button x:Name="BtnDeckBtnDown" Content="▼" Style="{StaticResource HudButtonStyle}" MinWidth="44" MinHeight="42" Padding="8,6" Margin="0,0,8,8" Click="BtnDeckBtnDown_Click" />
                                        <Button x:Name="BtnDeckBtnToggleFav" Content="★ Favorito" Style="{StaticResource HudButtonStyle}" MinHeight="42" Padding="14,6" Margin="0,0,8,8" Click="BtnDeckBtnToggleFav_Click" />
                                        <Button x:Name="BtnDeckBtnDelete" Content="🗑 Quitar" Style="{StaticResource HudButtonStyle}" MinHeight="42" Padding="14,6" Margin="0,0,0,8" Click="BtnDeckBtnDelete_Click" />
                                    </WrapPanel>

                                    <Border Background="{StaticResource HudPanelAltBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="AÑADIR / EDITAR BOTÓN" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,8" />
                                            <ComboBox x:Name="CmbDeckBtnAction" MinHeight="42" Margin="0,0,0,8" SelectionChanged="CmbDeckBtnAction_SelectionChanged" />
                                            <TextBox x:Name="TxtDeckBtnMacroSeq" MinHeight="40" Margin="0,0,0,8" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VerticalContentAlignment="Center" Padding="10,5" ToolTip="Opcional: Macro multi-paso (ej: LandingGearToggle, DELAY:150, ShipSpotLightToggle)" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtDeckBtnIcon" Grid.Column="0" MinHeight="42" Margin="0,0,8,0" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="17" Padding="6,4" ToolTip="Icono" TextChanged="DeckEditorPreviewField_Changed" />
                                                <TextBox x:Name="TxtDeckBtnLabel" Grid.Column="1" MinHeight="42" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VerticalContentAlignment="Center" Padding="10,5" ToolTip="Etiqueta visible del botón" TextChanged="DeckEditorPreviewField_Changed" />
                                            </Grid>
                                            <!-- Touch quick icons (1 tap) -->
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button Content="⚡" Tag="⚡" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="⚔" Tag="⚔" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="🛡" Tag="🛡" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="🚀" Tag="🚀" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="🛬" Tag="🛬" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="💡" Tag="💡" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="📦" Tag="📦" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="🔭" Tag="🔭" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="🚙" Tag="🚙" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="🥾" Tag="🥾" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="🔥" Tag="🔥" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,5,5" Click="BtnDeckQuickIcon_Click" />
                                                <Button Content="★" Tag="★" Style="{StaticResource HudButtonStyle}" MinWidth="40" MinHeight="38" Padding="4" Margin="0,0,0,5" Click="BtnDeckQuickIcon_Click" />
                                            </WrapPanel>

                                            <!-- Touch Size Stepper (0.5x - 4.0x) + Direct Color Swatches -->
                                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="Tamaño:" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                                <Button x:Name="BtnDeckSizeMinus" Content="−" Style="{StaticResource HudTouchStepButtonStyle}" Margin="0,0,6,6" Click="BtnDeckSizeStep_Click" Tag="-1" />
                                                <TextBlock x:Name="TxtDeckBtnSizeDisplay" Text="1.0×" Foreground="{DynamicResource HudAccentBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="14" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,6" />
                                                <Button x:Name="BtnDeckSizePlus" Content="+" Style="{StaticResource HudTouchStepButtonStyle}" Margin="0,0,14,6" Click="BtnDeckSizeStep_Click" Tag="1" />

                                                <TextBlock Text="Color:" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                                <Button Content="HUD" Tag="" Style="{StaticResource HudButtonStyle}" MinWidth="44" MinHeight="38" Padding="6,4" Margin="0,0,5,6" Click="BtnDeckQuickColor_Click" />
                                                <Button Content="●" Tag="#EF4444" Foreground="#EF4444" BorderBrush="#EF4444" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="4" Margin="0,0,5,6" ToolTip="Rojo Combate" Click="BtnDeckQuickColor_Click" />
                                                <Button Content="●" Tag="#22C55E" Foreground="#22C55E" BorderBrush="#22C55E" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="4" Margin="0,0,5,6" ToolTip="Verde Seguridad" Click="BtnDeckQuickColor_Click" />
                                                <Button Content="●" Tag="#06B6D4" Foreground="#06B6D4" BorderBrush="#06B6D4" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="4" Margin="0,0,5,6" ToolTip="Cian Exploración" Click="BtnDeckQuickColor_Click" />
                                                <Button Content="●" Tag="#F59E0B" Foreground="#F59E0B" BorderBrush="#F59E0B" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="4" Margin="0,0,5,6" ToolTip="Ámbar Alerta" Click="BtnDeckQuickColor_Click" />
                                                <Button Content="●" Tag="#A855F7" Foreground="#A855F7" BorderBrush="#A855F7" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="4" Margin="0,0,6,6" ToolTip="Violeta Especial" Click="BtnDeckQuickColor_Click" />
                                                <TextBox x:Name="TxtDeckBtnAccentHex" Width="88" MinHeight="38" MaxLength="7" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,0,6" ToolTip="Color HEX personalizado (ej. #00E5FF)" TextChanged="DeckEditorPreviewField_Changed" />
                                            </WrapPanel>

                                            <WrapPanel Margin="0,0,0,10">
                                                <CheckBox x:Name="ChkDeckBtnFavorite" Content="★ Mostrar en FAVORITOS" Foreground="{StaticResource HudTextBrush}" VerticalAlignment="Center" Margin="0,0,16,6" Click="DeckEditorPreviewCheck_Click" />
                                                <CheckBox x:Name="ChkDeckBtnConfirm" Content="⚠ Confirmar doble toque" Foreground="{StaticResource HudTextBrush}" VerticalAlignment="Center" Margin="0,0,0,6" Click="DeckEditorPreviewCheck_Click" />
                                            </WrapPanel>

                                            <!-- Live Touch Button Preview -->
                                            <Border x:Name="DeckButtonPreviewBorder" Background="#0B0F16" BorderBrush="{DynamicResource HudAccentBrush}" BorderThickness="1.8" Padding="12,8" Margin="0,0,0,10" HorizontalAlignment="Left" MinWidth="168" MinHeight="72">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtDeckPreviewIcon" Text="⚡" FontSize="19" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="TxtDeckPreviewLabel" Text="Vista previa" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,2" />
                                                    <TextBlock x:Name="TxtDeckPreviewMeta" Text="1.0×" Foreground="{DynamicResource HudMutedBrush}" FontFamily="Consolas" FontSize="10.5" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <WrapPanel>
                                                <Button x:Name="BtnDeckBtnAdd" Content="+ Añadir a pestaña" Style="{StaticResource HudButtonStyle}" MinHeight="42" Padding="14,6" Margin="0,0,10,4" Click="BtnDeckBtnAdd_Click" />
                                                <Button x:Name="BtnDeckBtnUpdate" Content="💾 Actualizar seleccionado" Style="{StaticResource HudButtonStyle}" MinHeight="42" Padding="14,6" Margin="0,0,0,4" Click="BtnDeckBtnUpdate_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="ConfigDiagnosticsSection" Visibility="Collapsed" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button x:Name="BtnScanUnhandledFiles" Content="🔍" local:UiText.TooltipKey="scanUnhandled" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Margin="0,0,6,0" Padding="8,5" Click="BtnScanUnhandledFiles_Click" />
                                        <Button x:Name="BtnCopyUnhandledJson" Content="📋" local:UiText.TooltipKey="copyUnhandled" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Margin="0,0,6,0" Padding="8,5" Click="BtnCopyUnhandledJson_Click" />
                                        <Button x:Name="BtnOpenUnhandledFile" Content="📂" local:UiText.TooltipKey="openUnhandledFile" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Margin="0,0,6,0" Padding="8,5" Click="BtnOpenUnhandledFile_Click" />
                                        <Button x:Name="BtnOpenLogsFolder" Content="🗂" local:UiText.TooltipKey="openLogsFolder" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Margin="0,0,6,0" Padding="8,5" Click="BtnOpenLogsFolder_Click" />
                                        <Button x:Name="BtnExportSupportBundle" Content="📦" local:UiText.TooltipKey="exportSupportBundle" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Margin="0,0,6,0" Padding="8,5" Click="BtnExportSupportBundle_Click" />
                                        <Button x:Name="BtnClearUnhandledEvents" Content="🗑" local:UiText.TooltipKey="clearUnhandled" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="8,5" Click="BtnClearUnhandledEvents_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="DIAGNÓSTICO DE MENSAJES Y FICHEROS NO TRATADOS" local:UiText.Key="diagnosticsTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Registra los eventos del Journal y ficheros auxiliares del juego que HUDnopy aún no procesa." local:UiText.Key="diagnosticsHelp" TextWrapping="Wrap" Foreground="{StaticResource HudMutedBrush}" FontSize="11" LineHeight="15" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox x:Name="ChkCaptureUnhandledEvents" Content="Registrar mensajes sin tratamiento" local:UiText.Key="captureUnhandled" Foreground="{StaticResource HudTextBrush}" Margin="0,0,14,4" Click="ChkCaptureUnhandledEvents_Click" />
                                    <CheckBox x:Name="ChkWriteUnhandledEventsFile" Content="Guardar automáticamente en disco" local:UiText.Key="writeUnhandledFile" Foreground="{StaticResource HudTextBrush}" Margin="0,0,14,4" Click="ChkWriteUnhandledEventsFile_Click" />
                                    <CheckBox x:Name="ChkGroupUnhandledEvents" Content="Agrupar por tipo de evento" local:UiText.Key="groupUnhandled" Foreground="{StaticResource HudTextBrush}" Margin="0,0,0,4" Click="ChkGroupUnhandledEvents_Click" />
                                </WrapPanel>
                                <DockPanel Margin="0,2,0,6">
                                    <TextBox x:Name="TxtUnhandledSearch" Width="260" MinHeight="38" HorizontalAlignment="Left" Padding="8,5" Background="#080A0E" Foreground="{DynamicResource HudTextBrush}" CaretBrush="{DynamicResource HudAccentBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VerticalContentAlignment="Center" local:UiText.TooltipKey="unhandledSearch" TextChanged="TxtUnhandledSearch_TextChanged" />
                                    <TextBlock x:Name="TxtUnhandledStatus" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0" />
                                </DockPanel>
                                <DataGrid x:Name="GridUnhandledEvents" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44" MinHeight="180" MaxHeight="340"
                                          Background="#090C10" Foreground="{StaticResource HudTextBrush}" RowBackground="#0E131A"
                                          AlternatingRowBackground="#131922" BorderBrush="#22FFFFFF" HeadersVisibility="Column"
                                          ColumnHeaderStyle="{StaticResource HudDataGridHeaderStyle}" CellStyle="{StaticResource HudDataGridCellStyle}"
                                          MouseDoubleClick="GridUnhandledEvents_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hora" local:TableHeader.Key="time" Binding="{Binding Timestamp}" Width="100" MinWidth="85" />
                                        <DataGridTextColumn Header="Origen" local:TableHeader.Key="source" Binding="{Binding Source}" Width="135" MinWidth="110" Visibility="Collapsed" />
                                        <DataGridTextColumn Header="Evento" local:TableHeader.Key="event" Binding="{Binding EventType}" Width="*" MinWidth="150" />
                                        <DataGridTextColumn Header="Veces" local:TableHeader.Key="occurrences" Binding="{Binding Count}" Width="90" MinWidth="75" />
                                        <DataGridTextColumn Header="JSON bruto (doble clic para copiar)" local:TableHeader.Key="rawJson" Binding="{Binding RawJson}" Width="*" MinWidth="240" FontFamily="Consolas" Visibility="Collapsed" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Background="{StaticResource HudPanelAltBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="12" Margin="0,14,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <WrapPanel DockPanel.Dock="Right">
                                                <Button x:Name="BtnReportLastError" Content="🐛 Reportar fallo / Asistente" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,5" Margin="0,0,6,0" Click="BtnReportLastError_Click" />
                                                <Button x:Name="BtnClearDiagnosticIssues" Content="🗑" ToolTip="Limpiar registro de incidencias recientes" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="8,5" Click="BtnClearDiagnosticIssues_Click" />
                                            </WrapPanel>
                                            <TextBlock Text="INCIDENCIAS Y ERRORES RECIENTES DE LA SESIÓN (ERROR / WARN)" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="TxtDiagnosticIssuesStatus" Text="0 incidencias registradas en esta sesión." Foreground="{StaticResource HudMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                                        <DataGrid x:Name="GridDiagnosticIssues" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="44" MinHeight="140" MaxHeight="260"
                                                  Background="#090C10" Foreground="{StaticResource HudTextBrush}" RowBackground="#0E131A"
                                                  AlternatingRowBackground="#131922" BorderBrush="#22FFFFFF" HeadersVisibility="Column"
                                                  ColumnHeaderStyle="{StaticResource HudDataGridHeaderStyle}" CellStyle="{StaticResource HudDataGridCellStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Hora" local:TableHeader.Key="time" Binding="{Binding TimestampUtc}" Width="95" MinWidth="85" />
                                                <DataGridTextColumn Header="Nivel" Binding="{Binding Level}" Width="85" MinWidth="75" />
                                                <DataGridTextColumn Header="Origen" local:TableHeader.Key="source" Binding="{Binding Category}" Width="140" MinWidth="110" />
                                                <DataGridTextColumn Header="Detalle" local:TableHeader.Key="details" Binding="{Binding Message}" Width="*" MinWidth="200" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="ConfigAboutSection" Visibility="Collapsed" Tag="440" SizeChanged="ResponsiveSplit_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="16" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="ACERCA DE HUDNOPY" local:UiText.Key="aboutTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                    <TextBlock Text="HUD de telemetría de código abierto para Elite Dangerous, MFD Web táctil, gestor de Fleet Carrier y copiloto IA COVAS." local:UiText.Key="aboutDesc" Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Versión:" local:UiText.Key="aboutVersionLabel" Foreground="{StaticResource HudMutedBrush}" Margin="0,0,10,4" />
                                        <TextBlock x:Name="TxtAboutVersion" Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource HudSecondaryBrush}" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Autor:" local:UiText.Key="aboutAuthorLabel" Foreground="{StaticResource HudMutedBrush}" Margin="0,0,10,4" />
                                        <TextBlock x:Name="TxtAboutAuthor" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource HudTextBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Licencia:" local:UiText.Key="aboutLicenseLabel" Foreground="{StaticResource HudMutedBrush}" Margin="0,0,10,4" />
                                        <TextBlock x:Name="TxtAboutLicense" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource HudTextBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Stack:" Foreground="{StaticResource HudMutedBrush}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text=".NET 10 · WPF · Kestrel HTTPS/WebSocket · NAudio · Piper TTS" Foreground="{DynamicResource HudSecondaryBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="ENLACES DEL PROYECTO" local:UiText.Key="aboutProjectLinks" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <Button x:Name="BtnAboutWeb" Content="🌐 Web" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button x:Name="BtnAboutGitHub" Content="💻 GitHub" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button x:Name="BtnAboutWiki" Content="📖 Wiki" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button x:Name="BtnAboutReleases" Content="📦 Releases" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button x:Name="BtnAboutIssues" Content="🐛 Issues" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,0,8" Click="BtnOpenExternalUrl_Click" />
                                    </WrapPanel>
                                    <Border Background="{StaticResource HudPanelAltBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="10" Margin="0,8,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkEnableAutoUpdateCheck" Content="Check GitHub Releases on startup (opt-in)" Foreground="{StaticResource HudTextBrush}" Margin="0,0,0,8" Click="ChkEnableAutoUpdateCheck_Click" />
                                            <WrapPanel>
                                                <Button x:Name="BtnCheckUpdates" Content="🔄 Check Updates" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,6" Click="BtnCheckUpdates_Click" />
                                                <Button x:Name="BtnOpenLatestRelease" Content="⬇ Download Release" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,6" Visibility="Collapsed" Click="BtnOpenExternalUrl_Click" />
                                                <Button x:Name="BtnRunFirstRunWizard" Content="🧭 Setup Wizard" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,0,6" Click="BtnRunFirstRunWizard_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="16" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="ECOSISTEMA Y WEBS COLABORADORAS" local:UiText.Key="aboutCommunityTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                                    <TextBlock Text="Acceso rápido a herramientas comunitarias, bases de datos y APIs de Elite Dangerous integradas o compatibles con HUDnopy." local:UiText.Key="aboutCommunityHelp" Foreground="{StaticResource HudMutedBrush}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,12" />
                                    <WrapPanel>
                                        <Button Content="🧭 Inara" Tag="https://inara.cz/elite/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="🗺 EDSM" Tag="https://www.edsm.net/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="🛰 Spansh" Tag="https://spansh.co.uk/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="🌌 EDAstro (DSSA)" Tag="https://edastro.com/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="📡 EDDN" Tag="https://github.com/EDCD/EDDN" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="🔬 Canonn R&amp;D" Tag="https://canonn.science/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="💹 Ardent Insight" Tag="https://api.ardent-insight.com/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="⚖ EliteBGS" Tag="https://elitebgs.app/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="🛠 EDSY" Tag="https://edsy.org/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="🚀 Coriolis" Tag="https://coriolis.io/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,8,8" Click="BtnOpenExternalUrl_Click" />
                                        <Button Content="⭐ Elite Dangerous" Tag="https://www.elitedangerous.com/" Style="{StaticResource HudButtonStyle}" MinHeight="38" Padding="12,6" Margin="0,0,0,8" Click="BtnOpenExternalUrl_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- BARRA DE ESTADO INFERIOR -->
        <Border x:Name="BottomStatusBar" Grid.Row="3" Background="#05070A" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="16,4">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnStatusBarIssuesPill" DockPanel.Dock="Right" Content="🐛 0" Visibility="Collapsed"
                        Style="{StaticResource HudButtonStyle}" BorderBrush="{DynamicResource HudDangerBrush}" Foreground="{DynamicResource HudDangerBrush}"
                        MinHeight="38" MinWidth="38" Padding="10,4" Margin="10,0,0,0" FontSize="11" FontWeight="Bold"
                        ToolTip="Incidencias registradas en esta sesión (clic para abrir el asistente de reporte)"
                        Click="BtnReportLastError_Click" />
                <StackPanel x:Name="ServiceHealthStrip" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="14,0,0,0" Cursor="Hand" ToolTip="Estado en vivo de integraciones externas (clic para detalles)" MouseLeftButtonUp="ServiceHealthStrip_Click" />
                <TextBlock x:Name="TxtStatusBarLeft" Text="Sistema listo. Monitorizando archivos de Elite Dangerous..." Foreground="{StaticResource HudMutedBrush}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- PANEL DESPLEGABLE DE SALUD DE SERVICIOS EXTERNOS -->
        <Border x:Name="ServiceHealthOverlay" Grid.Row="2" Panel.ZIndex="11" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="760" MinWidth="460"
                Margin="16,0,16,10" Padding="14" Background="{StaticResource HudPanelAltBrush}"
                BorderBrush="{DynamicResource HudAccentBrush}" BorderThickness="1.5">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="0" Margin="6,0,0,0" Click="CloseServiceHealthOverlay_Click" />
                    <Button DockPanel.Dock="Right" Content="🔄" ToolTip="Sincronizar servicios activos" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="4,0" Click="BtnRefreshServicesHealth_Click" />
                    <TextBlock Text="ESTADO DE SERVICIOS EXTERNOS" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
                <WrapPanel x:Name="ServiceHealthCardsGrid" />
            </StackPanel>
        </Border>

        <Border x:Name="AlertToast" Grid.Row="2" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="680" MinWidth="420"
                Margin="16" Padding="18" Background="{StaticResource HudPanelAltBrush}"
                BorderBrush="{DynamicResource HudDangerBrush}" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtAlertToastTitle" Foreground="{DynamicResource HudDangerBrush}" FontWeight="Black" FontSize="18" />
                    <TextBlock x:Name="TxtAlertToastMessage" Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Style="{StaticResource HudButtonStyle}" MinWidth="38" MinHeight="38" Padding="0" Margin="12,0,0,0" Click="DismissAlertToast_Click" />
            </Grid>
        </Border>

        <!-- POPUP HUD INTEGRADO DE DETALLE DE FILA (TÁCTIL) -->
        <Grid x:Name="RowDetailOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="30" Visibility="Collapsed"
              Background="#CC05070A"
              MouseLeftButtonDown="RowDetailOverlayBackdrop_MouseDown"
              MouseLeftButtonUp="RowDetailOverlayBackdrop_MouseUp">
            <Border x:Name="RowDetailCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="740" MaxWidth="820" MinWidth="380" MaxHeight="640" Margin="20" Padding="20"
                    Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudAccentBrush}" BorderThickness="2"
                    MouseLeftButtonDown="RowDetailCard_MouseLeftButtonDown"
                    MouseLeftButtonUp="RowDetailCard_MouseLeftButtonUp">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.85" BlurRadius="28" ShadowDepth="6" />
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button x:Name="BtnCloseRowDetail" DockPanel.Dock="Right" Content="✕"
                                Style="{StaticResource HudButtonStyle}" MinWidth="44" MinHeight="44"
                                FontSize="16" FontWeight="Bold" Padding="0" Margin="8,0,0,0"
                                Click="CloseRowDetailOverlay_Click" />
                        <Button x:Name="BtnCopyRowDetail" DockPanel.Dock="Right" Content="📋"
                                ToolTip="Copiar detalle al portapapeles" Style="{StaticResource HudButtonStyle}"
                                MinWidth="44" MinHeight="44" FontSize="15" Padding="0" Margin="8,0,0,0"
                                Click="BtnCopyRowDetail_Click" />
                        <Button x:Name="BtnNextRowDetail" DockPanel.Dock="Right" Content="▶"
                                ToolTip="Fila siguiente" Style="{StaticResource HudButtonStyle}"
                                MinWidth="44" MinHeight="44" FontSize="14" FontWeight="Bold" Padding="0"
                                Click="BtnNextRowDetail_Click" />
                        <TextBlock x:Name="TxtRowDetailCounter" DockPanel.Dock="Right" Text="1 / 1"
                                   Foreground="{DynamicResource HudSecondaryBrush}" FontFamily="Consolas"
                                   FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="10,0" />
                        <Button x:Name="BtnPrevRowDetail" DockPanel.Dock="Right" Content="◀"
                                ToolTip="Fila anterior" Style="{StaticResource HudButtonStyle}"
                                MinWidth="44" MinHeight="44" FontSize="14" FontWeight="Bold" Padding="0"
                                Click="BtnPrevRowDetail_Click" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtRowDetailCategory" Foreground="{DynamicResource HudAccentBrush}"
                                       FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="TxtRowDetailTitle" Foreground="{StaticResource HudTextBrush}"
                                       FontSize="18" FontWeight="Black" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="#33FFFFFF" Margin="0,0,0,14" />
                    <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RowDetailFieldsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

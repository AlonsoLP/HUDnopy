                                        <TextBox x:Name="TxtConfigBindingsPath" Grid.Column="1" AutomationProperties.LabeledBy="{Binding ElementName=LblBindingsPath}" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="8,6" />
                                        <Button x:Name="BtnBrowseBindingsFolder" Grid.Column="2" Content="📁" Style="{StaticResource HudButtonStyle}" MinWidth="40" Padding="4" Margin="6,0,0,0" Click="BtnBrowseBindingsFolder_Click" />

                                        <WrapPanel Margin="0,0,0,6">
                                            <CheckBox x:Name="ChkAiGlobalPttHotkey" Foreground="{StaticResource HudTextBrush}" VerticalAlignment="Center" Margin="0,0,8,4" Click="ChkAiGlobalPttHotkey_Click">

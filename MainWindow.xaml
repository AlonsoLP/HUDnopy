                                            </CheckBox>
                                            <ComboBox x:Name="CmbAiGlobalPttHotkey" Width="160" SelectedValuePath="Tag" SelectionChanged="CmbAiGlobalPttHotkey_SelectionChanged" Margin="0,0,0,4">
                                                <ComboBoxItem Content="Ctrl + Alt + V" Tag="Ctrl+Alt+V" />
                                                <ComboBoxItem Content="Ctrl + Alt + Space" Tag="Ctrl+Alt+Space" />
                                                <ComboBoxItem Content="Ctrl + Shift + V" Tag="Ctrl+Shift+V" />
                                                <ComboBoxItem Content="Alt + F1" Tag="Alt+F1" />
                                                <ComboBoxItem Content="F13" Tag="F13" />
                                            </ComboBox>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,0,0,10">
                                            <CheckBox x:Name="ChkAiRequireWakeWord" Foreground="{StaticResource HudTextBrush}" VerticalAlignment="Center" Margin="0,0,8,4" Click="ChkAiRequireWakeWord_Click">
                                                <TextBlock Text="Exigir palabra de activación en Manos Libres:" local:UiText.Key="aiWakeWordToggle" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <TextBox x:Name="TxtAiWakeWord" Width="120" Padding="6,3" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Margin="0,0,0,4" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="BtnSaveAiConfig" Content="💾 Guardar ajustes IA" local:UiText.Key="aiSaveBtn" Style="{StaticResource HudButtonStyle}" Padding="8,4" Margin="0,0,8,4" Click="BtnSaveAiConfig_Click" />
                                            <Button x:Name="BtnTestAiConfig" Content="🧪 Probar conexión IA" local:UiText.Key="aiTestBtn" Style="{StaticResource HudButtonStyle}" Padding="8,4" Margin="0,0,8,4" Click="BtnTestAiConfig_Click" />
                                            <Button x:Name="BtnClearAiMemory" Content="🧹 Borrar memoria IA" local:UiText.Key="aiClearMemoryBtn" Style="{StaticResource HudButtonStyle}" Padding="8,4" Margin="0,0,0,4" Click="BtnClearAiMemory_Click" />
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtAiMemoryPreview" Foreground="{StaticResource HudSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <TextBlock x:Name="TxtAiConfigStatus" Foreground="{StaticResource HudMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConfigVoiceSection" Visibility="Collapsed" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="MOTOR DE VOZ Y AUDIO" local:UiText.Key="speechEngineTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,6">
                                    <TextBlock Text="MOTOR DE VOZ" local:UiText.Key="speechEngineTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="CmbSpeechEngine" SelectedValuePath="Tag" SelectionChanged="CmbSpeechEngine_SelectionChanged" Margin="0,0,8,0">
                                        <ComboBoxItem Content="Windows SAPI (integrado)" local:UiText.Key="speechEngineSapi" Tag="sapi" />
                                        <ComboBoxItem Content="Piper TTS Neuronal (gratis, local)" local:UiText.Key="speechEnginePiper" Tag="piper" />
                                    </ComboBox>
                                </WrapPanel>
                                <Border x:Name="PiperVoicePanel" Visibility="Collapsed" Background="{StaticResource HudPanelAltBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,6">
                                            <TextBlock Text="Voz neuronal:" local:UiText.Key="piperVoiceLabel" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox x:Name="CmbPiperVoice" Width="310" SelectedValuePath="Key" SelectionChanged="CmbPiperVoice_SelectionChanged" Margin="0,0,8,6">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="BtnDownloadPiperVoice" Content="⬇ Descargar voz" local:UiText.Key="piperDownloadVoice" Style="{StaticResource HudButtonStyle}" Padding="8,4" Margin="0,0,6,6" Click="BtnDownloadPiperVoice_Click" />
                                            <Button x:Name="BtnDownloadPiperPack" Content="⬇ Pack 6 idiomas" local:UiText.Key="piperDownloadPack" Style="{StaticResource HudButtonStyle}" Padding="8,4" Margin="0,0,6,6" Click="BtnDownloadPiperPack_Click" />
                                            <Button x:Name="BtnTestPiperVoice" Content="▶" local:UiText.TooltipKey="testVoice" Style="{StaticResource HudIconButtonStyle}" Padding="6,4" Margin="0,0,0,6" VerticalAlignment="Center" Click="BtnTestPiperVoice_Click" />
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtPiperStatus" Foreground="{DynamicResource HudSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <WrapPanel x:Name="SapiVoiceRow" Margin="0,0,0,3">
                                    <TextBlock x:Name="LblAlertVoice" Text="VOZ LOCAL" local:UiText.Key="voiceTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="CmbAlertVoice" AutomationProperties.LabeledBy="{Binding ElementName=LblAlertVoice}" SelectedValuePath="VoiceName" SelectionChanged="CmbAlertVoice_SelectionChanged" ToolTip="Selecciona una voz SAPI instalada localmente en Windows" local:UiText.TooltipKey="voiceTip">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="BtnTestAlertVoice" Content="▶" local:UiText.TooltipKey="testVoice" Style="{StaticResource HudIconButtonStyle}" Padding="6,4" Margin="4,0,0,0" VerticalAlignment="Center" Click="BtnTestAlertVoice_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="TxtAlertVoiceStatus" Text="Las voces disponibles dependen de las características de voz instaladas en Windows." TextWrapping="Wrap" Foreground="{StaticResource HudMutedBrush}" FontSize="10" Margin="0,0,0,5" />
                                <TextBlock x:Name="LblSpeechRate" Text="VELOCIDAD DE VOZ" local:UiText.Key="voiceRateTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,4,0,5" />
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtSpeechRate" DockPanel.Dock="Right" Text="0" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <Slider x:Name="SldSpeechRate" Minimum="-5" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                            AutomationProperties.LabeledBy="{Binding ElementName=LblSpeechRate}" local:UiText.TooltipKey="voiceRateTip"
                                            ValueChanged="SldSpeechRate_ValueChanged" />
                                </DockPanel>
                                <WrapPanel Margin="0,4,0,5">
                                    <TextBlock x:Name="LblSpeechQueueMode" Text="COLA Y PRIORIDAD DE VOZ" local:UiText.Key="voiceQueueModeTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="CmbSpeechQueueMode" AutomationProperties.LabeledBy="{Binding ElementName=LblSpeechQueueMode}" SelectedValuePath="Tag" local:UiText.TooltipKey="voiceQueueModeTip" SelectionChanged="CmbSpeechQueueMode_SelectionChanged">
                                        <ComboBoxItem Content="Táctico (prioridad y vigencia)" local:UiText.Key="voiceQueueModeTactical" Tag="tactical" />
                                        <ComboBoxItem Content="Inmediato (interrumpir siempre)" local:UiText.Key="voiceQueueModeImmediate" Tag="immediate" />
                                        <ComboBoxItem Content="Secuencial (cola completa)" local:UiText.Key="voiceQueueModeSequential" Tag="sequential" />
                                    </ComboBox>
                                </WrapPanel>
                                <StackPanel x:Name="SpeechExpirationPanel">
                                    <TextBlock x:Name="LblSpeechExpiration" Text="CADUCIDAD DE VOZ EN COLA" local:UiText.Key="voiceExpirationTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,2,0,5" />
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock x:Name="TxtSpeechExpiration" DockPanel.Dock="Right" Text="5 s" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Slider x:Name="SldSpeechExpiration" Minimum="2" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                                AutomationProperties.LabeledBy="{Binding ElementName=LblSpeechExpiration}" local:UiText.TooltipKey="voiceExpirationTip"
                                                ValueChanged="SldSpeechExpiration_ValueChanged" />
                                    </DockPanel>
                                </StackPanel>
                                <Separator Background="#22FFFFFF" Margin="0,10,0,10" />
                                <TextBlock Text="CARPETAS DE SONIDOS" local:UiText.Key="soundDirsTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,0,0,5" />
                                <TextBlock Text="Vincula carpetas para seleccionar sonidos propios." local:UiText.Key="soundDirsHelp" Foreground="{StaticResource HudMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
                                <ListBox x:Name="LstSoundDirectories" MinHeight="42" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                <WrapPanel Margin="0,5,0,4">
                                    <Button Content="Vincular carpeta" local:UiText.Key="soundDirAdd" Style="{StaticResource HudButtonStyle}" Margin="0,0,6,4" Click="BtnAddSoundDirectory_Click" />
                                    <Button Content="Desvincular carpeta" local:UiText.Key="soundDirRemove" Style="{StaticResource HudButtonStyle}" Margin="0,0,6,4" Click="BtnRemoveSoundDirectory_Click" />
                                    <Button Content="Actualizar sonidos" local:UiText.Key="soundDirRefresh" Style="{StaticResource HudButtonStyle}" Margin="0,0,6,4" Click="BtnRefreshSoundDirectories_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="TxtSoundDirectoryStatus" Foreground="{StaticResource HudMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="VOLUMEN MAESTRO DE SONIDOS" local:UiText.Key="volumeTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,2,0,5" />
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtAlertSoundVolume" DockPanel.Dock="Right" Text="100 %" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <Slider x:Name="SldAlertSoundVolume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SldAlertSoundVolume_ValueChanged" ToolTip="Ajusta el nivel de los sonidos de alerta sin cambiar el volumen del juego ni de Windows" local:UiText.TooltipKey="volumeTip" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConfigAlertsSection" Visibility="Collapsed" Background="{StaticResource HudPanelBrush}" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="ALERTAS POR TIPO Y CANAL" local:UiText.Key="alertsTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                                    <TextBlock Text="Avisos visuales, sonidos y voz local. Elige una voz instalada de Windows; la voz solo se reproduce para alertas con ese canal activado." local:UiText.Key="alertsHelp" TextWrapping="Wrap" Foreground="{StaticResource HudMutedBrush}" FontSize="11" LineHeight="15" />
                                </StackPanel>
                                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="UMBRALES DE ALERTA" local:UiText.Key="thresholdsTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,2,0,5" />
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Combustible: aviso / crítico (% del depósito):" local:UiText.Key="fuelThreshold" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,2" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="TxtFuelLowThreshold" Width="42" Text="20" Margin="4,0" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="5,3" />
                                            <TextBox x:Name="TxtFuelCriticalThreshold" Width="42" Text="10" Margin="4,0" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="5,3" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Casco crítico (por debajo de %):" local:UiText.Key="hullThreshold" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,2" />
                                        <TextBox x:Name="TxtHullCriticalThreshold" Grid.Row="1" Grid.Column="1" Width="42" Text="50" Margin="4,0" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="5,3" />
                                        <TextBlock Grid.Row="2" Text="Misiones: aviso / crítico antes del vencimiento (horas):" local:UiText.Key="missionThreshold" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,2" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="TxtMissionExpiryWarningHours" Width="42" Text="24" Margin="4,0" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="5,3" />
                                            <TextBox x:Name="TxtMissionExpiryCriticalHours" Width="42" Text="1" Margin="4,0" Background="#080A0E" Foreground="{StaticResource HudTextBrush}" BorderBrush="{DynamicResource HudBorderBrush}" Padding="5,3" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="Aplicar umbrales" local:UiText.Key="applyThresholds" HorizontalAlignment="Left" Style="{StaticResource HudButtonStyle}" Padding="8,4" Click="BtnSaveAlertThresholds_Click" />
                                </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1" Padding="12">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="AlertSettings_PreviewMouseWheel">
                                    <Grid x:Name="AlertSettingsGrid" />
                                </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="ConfigDiagnosticsSection" Visibility="Collapsed" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="DIAGNÓSTICO DE MENSAJES Y FICHEROS NO TRATADOS" local:UiText.Key="diagnosticsTitle" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                                <TextBlock Text="Registra los eventos del Journal y ficheros JSON auxiliares del juego que HUDnopy aún no procesa, conservando su estructura JSON original para facilitar el diseño de nuevas funciones." local:UiText.Key="diagnosticsHelp" TextWrapping="Wrap" Foreground="{StaticResource HudMutedBrush}" FontSize="11" LineHeight="15" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkCaptureUnhandledEvents" Content="Registrar mensajes y ficheros del juego sin tratamiento" local:UiText.Key="captureUnhandled" Foreground="{StaticResource HudTextBrush}" Margin="0,0,0,6" Click="ChkCaptureUnhandledEvents_Click" />
                                <CheckBox x:Name="ChkWriteUnhandledEventsFile" Content="Volcar automáticamente en disco (unhandled_events.jsonl)" local:UiText.Key="writeUnhandledFile" Foreground="{StaticResource HudTextBrush}" Margin="0,0,0,6" Click="ChkWriteUnhandledEventsFile_Click" />
                                <CheckBox x:Name="ChkGroupUnhandledEvents" Content="Agrupar por tipo de evento (mostrar contador y último JSON)" local:UiText.Key="groupUnhandled" Foreground="{StaticResource HudTextBrush}" Margin="0,0,0,10" Click="ChkGroupUnhandledEvents_Click" />
                                <WrapPanel Margin="0,2,0,4">
                                    <TextBox x:Name="TxtUnhandledSearch" Width="220" Margin="0,0,8,6" Padding="6,5" Background="#080A0E" Foreground="{DynamicResource HudTextBrush}" CaretBrush="{DynamicResource HudAccentBrush}" BorderBrush="{DynamicResource HudBorderBrush}" VerticalContentAlignment="Center" local:UiText.TooltipKey="unhandledSearch" TextChanged="TxtUnhandledSearch_TextChanged" />
                                    <Button x:Name="BtnScanUnhandledFiles" Content="🔍 Analizar ficheros actuales" local:UiText.Key="scanUnhandled" Style="{StaticResource HudButtonStyle}" Margin="0,0,6,6" Padding="10,5" Click="BtnScanUnhandledFiles_Click" />
                                    <Button x:Name="BtnCopyUnhandledJson" Content="📋 Copiar JSON" local:UiText.Key="copyUnhandled" Style="{StaticResource HudButtonStyle}" Margin="0,0,6,6" Padding="10,5" Click="BtnCopyUnhandledJson_Click" />
                                    <Button x:Name="BtnOpenUnhandledFile" Content="📂 Abrir fichero" local:UiText.Key="openUnhandledFile" Style="{StaticResource HudButtonStyle}" Margin="0,0,6,6" Padding="10,5" Click="BtnOpenUnhandledFile_Click" />
                                    <Button x:Name="BtnClearUnhandledEvents" Content="🗑 Limpiar" local:UiText.Key="clearUnhandled" Style="{StaticResource HudButtonStyle}" Margin="0,0,0,6" Padding="10,5" Click="BtnClearUnhandledEvents_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="TxtUnhandledStatus" Foreground="{StaticResource HudMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                <DataGrid x:Name="GridUnhandledEvents" AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="#090C10" Foreground="{StaticResource HudTextBrush}" RowBackground="#0E131A"
                                          AlternatingRowBackground="#131922" BorderBrush="#22FFFFFF" HeadersVisibility="Column"
                                          ColumnHeaderStyle="{StaticResource HudDataGridHeaderStyle}" CellStyle="{StaticResource HudDataGridCellStyle}"
                                          MouseDoubleClick="GridUnhandledEvents_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hora" local:TableHeader.Key="time" Binding="{Binding Timestamp}" Width="90" MinWidth="85" />
                                        <DataGridTextColumn Header="Origen" local:TableHeader.Key="source" Binding="{Binding Source}" Width="135" MinWidth="110" />
                                        <DataGridTextColumn Header="Evento" local:TableHeader.Key="event" Binding="{Binding EventType}" Width="185" MinWidth="140" />
                                        <DataGridTextColumn Header="Veces" local:TableHeader.Key="occurrences" Binding="{Binding Count}" Width="80" MinWidth="70" />
                                        <DataGridTextColumn Header="JSON bruto (doble clic para copiar)" local:TableHeader.Key="rawJson" Binding="{Binding RawJson}" Width="*" MinWidth="240" FontFamily="Consolas" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- BARRA DE ESTADO INFERIOR -->
        <Border x:Name="BottomStatusBar" Grid.Row="3" Background="#05070A" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock x:Name="TxtStatusBarLeft" Text="Sistema listo. Monitorizando archivos de Elite Dangerous..." Foreground="{StaticResource HudMutedBrush}" FontSize="11" />
                <TextBlock x:Name="TxtStatusBarRight" Text="Al cerrar con [X] continúa activo en la bandeja del sistema" Foreground="{DynamicResource HudAccentBrush}" FontSize="11" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <Border x:Name="AlertToast" Grid.Row="2" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="680" MinWidth="420"
                Margin="16" Padding="18" Background="{StaticResource HudPanelAltBrush}"
                BorderBrush="{DynamicResource HudDangerBrush}" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtAlertToastTitle" Foreground="{DynamicResource HudDangerBrush}" FontWeight="Black" FontSize="18" />
                    <TextBlock x:Name="TxtAlertToastMessage" Foreground="{StaticResource HudTextBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="×" Style="{StaticResource HudButtonStyle}" MinWidth="28" MinHeight="28" Padding="0" Margin="12,0,0,0" Click="DismissAlertToast_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>

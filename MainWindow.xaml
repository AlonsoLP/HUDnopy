                                <Button x:Name="BtnAiPreFlightCheck" Content="✈ Chequeo pre-vuelo" local:UiText.Key="aiPreFlightBtn" Style="{StaticResource HudButtonStyle}" Padding="8,4" Margin="0,0,6,6" Click="BtnAiPreFlightCheck_Click" />
                                <Button x:Name="BtnAiSummarizeGalnet" Content="✨ Resumir GalNet" local:UiText.Key="aiSummarizeGalnet" Style="{StaticResource HudButtonStyle}" Padding="8,4" Margin="0,0,6,6" Click="BtnAiSummarizeGalnet_Click" />

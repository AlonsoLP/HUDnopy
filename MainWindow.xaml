                    </StackPanel>
                </ScrollViewer>

                <!-- AJUSTES, SERVIDOR WEB Y TEMA VISUAL -->
                <ScrollViewer x:Name="ViewConfig" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Style.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </Style.Resources>
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="MinWidth" Value="44" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                                    Background="{DynamicResource HudPanelAltBrush}"
                                                    BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1">
                                                <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="2"
                                                         HorizontalAlignment="Left" Fill="{DynamicResource HudMutedBrush}" />
                                            </Border>
                                            <ContentPresenter x:Name="SwitchLabel" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                              ContentSource="Content" RecognizesAccessKey="True" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource HudAccentDimBrush}" />
                                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
                                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource HudAccentBrush}" />
                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="HasContent" Value="False">
                                                <Setter TargetName="SwitchLabel" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <Grid x:Name="ConfigInterfaceSection" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{DynamicResource HudBorderBrush}" BorderThickness="1,2,1,1" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="APARIENCIA Y VENTANA" local:UiText.Key="interface" Foreground="{DynamicResource HudAccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtLanguageLabel" Text="Idioma:" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <ComboBox x:Name="CmbUiLanguage" SelectedValuePath="Tag" SelectionChanged="CmbUiLanguage_SelectionChanged">
                                            <ComboBoxItem Content="Español" Tag="es-ES" />
                                            <ComboBoxItem Content="English" Tag="en-GB" />
                                            <ComboBoxItem Content="Français" Tag="fr-FR" />
                                            <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                                            <ComboBoxItem Content="Русский" Tag="ru-RU" />
                                            <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR" />
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtLanguageWarning" Foreground="{StaticResource HudMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                                    <CheckBox x:Name="ChkHideNavigationMenuText" Content="Ocultar los nombres de las secciones del menú (mantener iconos)" local:UiText.Key="hideMenu" Foreground="{StaticResource HudTextBrush}" Margin="0,0,0,8" Click="ChkHideNavigationMenuText_Click" />
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Posición del menú (aplicación y web):" local:UiText.Key="menuPosition" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ComboBox x:Name="CmbNavigationMenuPosition" Width="130" Margin="10,0,0,0" HorizontalAlignment="Right" SelectedValuePath="Tag" SelectionChanged="CmbNavigationMenuPosition_SelectionChanged">
                                            <ComboBoxItem Content="Izquierda" local:UiText.Key="left" Tag="left" />
                                            <ComboBoxItem Content="Derecha" local:UiText.Key="right" Tag="right" />
                                            <ComboBoxItem Content="Arriba" local:UiText.Key="top" Tag="top" />
                                            <ComboBoxItem Content="Abajo" local:UiText.Key="bottom" Tag="bottom" />
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Tamaño de fuente:" local:UiText.Key="fontSize" Foreground="{StaticResource HudMutedBrush}" VerticalAlignment="Center" />

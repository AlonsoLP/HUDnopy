<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HUDnopy</RootNamespace>
    <AssemblyName>HUDnopy</AssemblyName>
    <Product>HUDnopy</Product>
    <Version>0.4.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>AlonsoLP</Authors>
    <Copyright>Copyright (c) 2026 AlonsoLP</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://alonsolp.github.io/HUDnopy/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AlonsoLP/HUDnopy</RepositoryUrl>
    <Description>Elite Dangerous telemetry HUD, Web MFD, Fleet Carrier manager, and AI copilot (early preview).</Description>
    <ApplicationIcon>HUDnopy.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <DefaultItemExcludes>$(DefaultItemExcludes);HUDnopy.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HUDnopy.Tests" />
    <AssemblyMetadata Include="Authors" Value="$(Authors)" />
    <AssemblyMetadata Include="License" Value="GNU $(PackageLicenseExpression)" />
    <AssemblyMetadata Include="WebsiteUrl" Value="$(PackageProjectUrl)" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="System.Speech" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="HUDnopy.ico" />
    <EmbeddedResource Include="Resources\Languages\*.json" />
    <Content Include="Web\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Audio\alert-sound-library.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
